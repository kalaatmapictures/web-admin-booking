# Salin menjadi .env (lokal) atau isi di Vercel → Project Settings → Environment Variables.
# Gunakan project Supabase yang SAMA dengan landing page (repo form-booking).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Alamat landing page booking, untuk tombol "Lihat landing page"
VITE_LANDING_URL=http://localhost:5173
