# Salin menjadi .env.local untuk pengembangan lokal:  cp .env.example .env.local
# Di Vercel, isi di Project Settings → Environment Variables.
# JANGAN commit file .env.local. Jangan beri awalan NEXT_PUBLIC_ pada nilai rahasia.

# --- Supabase (Project Settings → API) -------------------------------------
# Publik: boleh terlihat di browser, akses dibatasi oleh RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA, hanya server: melewati RLS. Dipakai untuk galeri klien setelah token diverifikasi.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplikasi ---------------------------------------------------------------
# Alamat publik aplikasi, dipakai untuk membuat tautan galeri.
# Lokal: http://localhost:3000 · Produksi: https://<domain-anda>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Drive (Tahap 3, belum dipakai) ------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_ENCRYPTION_KEY=
